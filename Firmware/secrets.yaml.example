# Copia este archivo a "secrets.yaml" y rellena tus valores.
#   cp secrets.yaml.example secrets.yaml
# secrets.yaml está en .gitignore: NO se sube al repo.

# --- WiFi -------------------------------------------------------------------
wifi_ssid: "TuRedWiFi"
wifi_password: "TuPasswordWiFi"

# Password del AP de fallback (si se cae el WiFi principal).
ap_password: "cambia-esto-1234"

# --- Seguridad ESPHome ------------------------------------------------------
# Clave de cifrado de la API (32 bytes en base64).
# Genera una en: https://esphome.io/components/api.html  (botón "Generate")
# o con:  openssl rand -base64 32
api_encryption_key: "PON_AQUI_UNA_CLAVE_BASE64_DE_32_BYTES="

# Password para actualizaciones OTA.
ota_password: "cambia-esto-ota"
